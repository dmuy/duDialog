{
  "name": "@dmuy/dialog",
  "version": "1.2.0-rc",
  "description": "A simple material concept dialog plugin",
  "keywords": [
    "dialog",
    "material-dialog",
    "selection-dialog",
    "dialog-plugin",
    "multi-select-dialog"
  ],
  "license": "MIT",
  "author": {
    "name": "Dionlee Uy",
    "email": "dionleeuy@gmail.com"
  },
  "repository": "git://github.com/dmuy/duDialog.git",
  "homepage": "https://dmuy.github.io/duDialog/",
  "main": "dist/duDialog.js",
  "type": "module",
  "types": "dist/duDialog.d.ts",
  "files": [
    "dist",
    "vue-dialog.js",
    "vue3-dialog.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run minify-es-build && npm run minify-umd-build && npm run minify-css",
    "minify-es-build": "esbuild dist/duDialog.es.js --minify --outfile=dist/duDialog.es.min.js --allow-overwrite",
    "minify-umd-build": "esbuild dist/duDialog.js --minify --outfile=dist/duDialog.min.js --allow-overwrite",
    "minify-css": "esbuild dist/duDialog.css --minify --outfile=dist/duDialog.min.css --allow-overwrite"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "sass": "^1.78.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.2.1"
  }
}
